#!/usr/bin/env ruby

# Copyright 2020, Kurt A. Stephens

require 'rubygems'
require 'set'
require 'csv'
require 'fileutils'
require 'shellwords'
require 'tempfile'
require 'cgi/util'
require 'pp'

class Csvx
  module PPClean
    def self.included target
      target.extend(self)
    end
    def pp *args
      PP.pp(*args, $stderr)
    end
    def pps *args
      PP.pp(*args, ''.dup)
    end
  end
  include PPClean
  
  attr_reader :progname, :args, :command, :table, :selected_columns, :header, :script
  attr_accessor :method_command

  def self.csv_parse_line line, lineno = nil
    ::CSV.parse_line(line)
  rescue ::CSV::MalformedCSVError
    $stderr.puts "  # cx : WARN: Removing \" : #{$!.inspect} : line #{lineno} : #{line.inspect}"
    line = line.gsub('"', '')
    begin
      ::CSV.parse_line(line)
    rescue ::CSV::MalformedCSVError
      $stderr.puts "  # cx : WARN: Falling back to split on \",\" : #{$!.inspect} : line #{lineno} #{line.inspect}"
      line.split(',', -1)
    end
  end

  def self.csv_parse io
    lineno = -1
    rows = [ ]
    until io.eof?
      rows << csv_parse_line(io.readline, lineno += 1)
    end
    rows
  end

  def initialize args
    @progname = File.basename($0)
    @args = args.map(&:dup)
    @command = ['UNKNOWN']
    @inp = @inp_file = nil
    @out = @out_file = nil
    @log = $stderr
    @verbose = @debug = false
    @mkdir = false
    @pipe = false
    # @verbose = true
  end

  def File_open_mkdir file, *args
    FileUtils.mkdir_p(File.dirname(file)) if @mkdir
    File.open(file, *args)
  end
  
  def inp
    @inp ||= @inp_file ? File.open(@inp_file, "r") : $stdin
  end
  def out
    @out ||= @out_file ? File_open_mkdir(@out_file, "w") : $stdout
  end

  def prog
    File.basename(command[0])
  end

  def table!
    desc  = Table::Desc.new(inp.readline)
    @header = desc.header
    msg "< #{command * ' '} : header #{@header.inspect}"
    @table = Table.new(LazyCSV.new(inp), desc, @inp_file || '-')
    self
  end

  def columns
    @columns || @table.desc.cols
  end
  
  def opts!
    loop do
      case arg = @args.shift
      when '--mkdir'
        @mkdir = true
      when '--in'
        @inp_file = @args.shift or raise ArgumentError
      when '--out'
        @out_file = @args.shift or raise ArgumentError
      when '--in-out'
        @inp_file = @args.shift or raise ArgumentError
        @out_file = @args.shift or raise ArgumentError
      when '--verbose'
        @verbose = true
      when '--debug'
        @debug = true
      when '--help'
        help!; exit
      when '---test---'
        exit! Test.new.run!
      else
        @args.unshift(arg)
        break
      end
    end
    self
  end
  
  def command!
    @command = @args.dup
    case command[0]
    when 'sort'
      cmd = [ ]
      command.insert(1, '-t,')
      args = command.dup
      while arg = args.shift
        case arg
        when /^--?K(.*)$/
          arg = $1.empty? ? args.shift : $1
          arg, ind, names = table.desc.replace_col_names(arg)          
          arg.split(',').each do | field |
            case field
            when /^(\d+)(.*)/
              pos, opt = $1, $2
              field = "#{pos},#{pos}#{opt}"
            end
            cmd << '-k' << field
          end
        else
          cmd << arg
        end
      end
      @command = cmd
    when 'datamash'
      cmd = [ command[0], '-t,', '--no-strict']
      cols = [ ]
      args = command.dup
      args.shift
      while arg = args.shift
        case arg
        when '--full', '-f'
          cmd << "--full"
          cols = columns.dup
        when /^(--group=(.*)|group)$/
          fields = $2 || args.shift
          arg, ind, names = table.desc.replace_col_names(fields)
          ind.sort!
          ind.reject!(&:negative?)
          arg = ind.map(&:to_s) * ','
          cmd << "--group=#{arg}"
          cols.concat(ind.map{|i| columns[i - 1]})
        when /^\w+(:\d+)?$/
          op = arg
          col = args.shift
          a, inds, n = table.desc.replace_col_names(col)
          op_ = op.gsub(/\W+/, '_')
          cols.concat(n.map{|s| "#{s}_#{op_}"})
          cmd << op << a
        else
          cmd << arg
        end
      end
      @columns = cols
      @command = cmd
    when 'cut'
      cmd = [ command[0], '-d,' ]
      cols = columns.dup
      args = command.dup
      args.shift
      while arg = args.shift
        case arg
        when /^-f(.*)$/
          fields = $1.empty? ? args.shift : $1
          arg, ind, names = table.desc.replace_col_names(fields)
          ind.sort!
          ind.reject!(&:negative?)
          ind.uniq!
          cols = ind.map{|i| table.desc.c_to_c(i - 1)}
          # pp(arg: arg, ind: ind, names: names, cols: cols)
          cmd << "-f" << ind.map(&:to_s) * ','
        else
          cmd << arg
        end
      end
      @columns = cols
      @command = cmd
      # pp(@command); exit
    when 'awk-'
      # Very difficult to do automatically
      # may require additional -C columns,... option
      cmd = [ 'awk', '-F,' ]
      args = command.dup
      args.shift
      while arg = args.shift
        case arg
        when /^--?C(.*)$/
          fields = $1.empty? ? args.shift : $1
          @columns = fields.split(',')
        else
          arg, ind, names = table.desc.replace_col_names(fields, lambda{|c, n| "$#{c}"})
          cmd << arg
        end
      end
      @command = cmd
    when 'grep-'
      # cx grep- [-vie] %field% pattern ...
      cmd = [ 'egrep', '-E' ]
      args = command.dup
      args.shift
      referenced = { }
      while arg = args.shift
        case arg
        when /^%(.*)%$/
          col = $1
          pat = args.shift
          referenced[col] = pat
        else
          cmd << arg
        end
      end
      rx = columns.map do | c |
        referenced[c] || '[^,]*'
      end
      # log(:grep, rx, :force)
      rx = "^#{rx * ','}$"
      cmd << '-e' << rx
      @command = cmd
      # log(:grep, @command, :force)
    when /^(table|html|eval|rownum|join)-$/
      cmd = $1
      command_ = command.dup
      command.shift
      self.method_command = [ :"command_#{cmd}!", *command ]
      @command = command_
    end
    log(:command!, args: @args, command: command, columns: columns)
    self
  end

  def command_rownum! *args
    colname = (args[0] || "_rownum")
    rownum  = (args[1] || 1).to_i - 1
    table.desc.cols = [ colname, *table.desc.cols ]
    table.each{|r| r.unshift(rownum += 1)}
    table.write_csv!(out)
    self
  end
  
  def command_join! *args
    table = self.table
    j = { }
    j[:l_table] = table
    j[:l_alias] = args.shift
    j[:l_cols]  = args.shift
    j[:l_join]  = args.shift
    j[:op]      = args.shift
    j[:r_join]  = args.shift
    j[:r_cols]  = args.shift
    j[:r_alias] = args.shift
    j[:r_table] = args.shift
    j.each do | k, v |
      raise ArgumentError, "#{k} unspecified" unless v
    end

    # pp(j_opts: j)
    
    j[:r_table] = Table.new(LazyCSV.new(File.open(j[:r_table])), nil, j[:r_table])
    
    join_table = Table.join(j)
    join_table.write_csv!(out)
    self
  end
  
  def command_eval! *args
    table = tabular_rows []
    fn = "Proc.new do \n " + args.join(" ;\n") + "\nend\n"
    fn = eval(fn)
    ec = RowContext.new
    table.each do | r |
      catch(:skip!) do
        ec.__r = r
        ec.instance_eval(&fn)
      end
    end
    table.write_csv!(out)
    self
  end

  class RowContext < BasicObject
    attr_accessor :__r
    
    def initialize
      @__col = ::Hash.new{|h, sel| h[sel] = __col(sel)}
    end

    def __col sel
      desc = @__r.desc
      m = /^([^=]*)(=?)$/.match(sel.to_s)
      until i = desc.c_to_i(m[1])
        desc << m[1]
      end
      [ m[2].empty? ? :[] : :[]=, i ]
    end

    def skip!
      @__r.skip!
      throw(:skip!)
      self
    end
    
    def method_missing sel, *args, &blk
      meth_i = @__col[sel]
      @__r.send(*meth_i, *args, &blk)
    # rescue => exc
      # ::PP.pp(exc: exc)
      #  exc.message.insert(0, "in #{sel}(#{args.map(&:inspect) * ', '}) : #{@__r.inspect}")
      #  exc.raise
    end
  end
  
  def command_table! *args
    require 'terminal-table'
    table = tabular_rows args
    # max_width = table.map{|r| r.join(' | ').size}.max
    # $stderr.puts max_width; exit
    tt = Terminal::Table.new(headings: table.desc.cols, rows: table)
    tt.style = { :border_top => false, :border_bottom => false, } # width: [ max_width, 299 ].min }
    table.desc.cols.each_with_index do | c, i |
      tt.align_column(i, :right) if table.col_type(c) == ::Numeric
    end
    out.puts tt
    self
  end

  def command_html! *args
    table = tabular_rows args

    desc = table.desc
    cols = desc.cols

    # https://css-tricks.com/position-sticky-and-table-headers/
    sticky = {style: 'position: sticky; top: 0;'}
    right = {style: 'text-align: right;'}
    h = @h = HTML.new(self.out)
    h << HTML_HEAD
    h.body do
      h.table(id: 'table-id',
              position: :relative,
              # :'border-collapse' => :collapse
             ) do
        h.thead do
          h.tr do
            a = sticky.dup
            a[:"data-sort-method"] = :number
            h.th(a, "#")
            cols.each do | c |
              a = sticky.dup
              a[:"data-sort-method"] = :number if table.col_type(c) == ::Numeric
              h.th(a) do
                link(c, c)
              end
            end
          end
        end
        h.tbody do
          td_attrs = cols.map{|c| table.col_type(c) == ::Numeric ? right : nil}
          inds = cols.map{|c| desc.c_to_i(c) }
          table.each_with_index do | r, ri |
            ri += 1
            row_name="#{ri}"
            h.tr(title: "Row #{ri}") do
              h.td(right) do
                link(ri, ri)
              end
              inds.each_with_index do | ci, i |
                h.td(td_attrs[i]) do
                  link("#{ri}-#{cols[i]}", r[ci])
                end
              end
            end
          end
        end
      end
    end
    h << HTML_FOOT
    self
  end
  
  def link name, str
    name = name.to_s
    str = str.to_s
    unless name == str
      str_name = str.strip.split(/[^-_a-zA-Z0-9]/, 2).first
      str_name &&= str_name.strip
      str_name = nil if str_name && str_name.empty?
      name = name + '-' + str_name if str_name
    end
    name = name.to_s.gsub(/[^-_a-zA-Z0-9]/, '_')
    @h.a({name: name}) do
      @h.a({href: "\##{name}"}, str)
    end
  end

  class HTML < BasicObject
    include PPClean
    def initialize out
      @out = out
      @html_sep   = ::Hash[%w(span td th a dt dd).map{|t| [t.to_sym, ""]}]
      @html_open  = ::Hash.new{|h, tag| h[tag.to_sym] = "<#{tag}>".freeze}
      @html_close = ::Hash.new{|h, tag| h[tag.to_sym] = "</#{tag}>".freeze}
    end
    
    def _tag tag, attrs = nil, content = nil, &blk
      tag = tag.to_sym
      if attrs && ! content && ! ::Hash === attrs
        content, attrs = attrs, nil
      end
      
      attrs &&= attrs.map{|k,v| v.nil? || "#{k}='#{v}'"}.compact
      attrs = nil if attrs && attrs.empty?
      attrs &&= attrs.join(' ')
      ws = @html_sep[tag] ||= "\n"
      
      @out << (attrs ? "<#{tag} #{attrs}>" : @html_open[tag]) << ws

      close = false
      case
      when content
        close = true
        text(content)
      when blk
        close = true
        yield
      end
      @out << @html_close[tag] << "\n" if close
      self
    end
    
    def << x
      @out << x.to_s
    end

    def text x
      @out << ::CGI::escapeHTML(x.to_s)
    end
    
    def method_missing sel, *args, &blk
      _tag(sel, *args, &blk)
    end
  end
  
  HTML_HEAD = <<END
<html>
<head>
<style type="text/css">
body {
font-family: Arial, Helvetica, sans-serif;
background-color: #000;
color: #eee;
}
table {
border-collapse: collapse;
}
thead th {
 background-color: #333;
 border: 0.1rem solid #111
}
a {
  color: inherit; /* blue colors for links too */
  text-decoration: inherit; /* no underline */
}
/*
a {
}
a:link, a:visited {
}
*/
tr:hover {background-color: #444;}
tr:nth-child(even) {background-color: #222;}
th, td {
  padding: 0.5rem 1rem;
  border-bottom: 1px solid #555;
}
/* https://stackoverflow.com/questions/1312236/how-do-i-create-an-html-table-with-a-fixed-frozen-left-column-and-a-scrollable-b */
.headcol {
  position: absolute;
  width: 5em;
  left: 0;
  top: auto;
  border-top-width: 1px;
  /*only relevant for first row*/
  margin-top: -1px;
  /*compensate for top border*/
}
</style>
</head>
END
  
  HTML_FOOT = <<END
<script type="text/javascript">
/*!
 * tablesort v5.1.0 (2018-09-14)
 * http://tristen.ca/tablesort/demo/
 * Copyright (c) 2018 ; Licensed MIT
*/
!function(){function a(b,c){if(!(this instanceof a))return new a(b,c);if(!b||"TABLE"!==b.tagName)throw new Error("Element must be a table");this.init(b,c||{})}var b=[],c=function(a){var b;return window.CustomEvent&&"function"==typeof window.CustomEvent?b=new CustomEvent(a):(b=document.createEvent("CustomEvent"),b.initCustomEvent(a,!1,!1,void 0)),b},d=function(a){return a.getAttribute("data-sort")||a.textContent||a.innerText||""},e=function(a,b){return a=a.trim().toLowerCase(),b=b.trim().toLowerCase(),a===b?0:a<b?1:-1},f=function(a,b){return function(c,d){var e=a(c.td,d.td);return 0===e?b?d.index-c.index:c.index-d.index:e}};a.extend=function(a,c,d){if("function"!=typeof c||"function"!=typeof d)throw new Error("Pattern and sort must be a function");b.push({name:a,pattern:c,sort:d})},a.prototype={init:function(a,b){var c,d,e,f,g=this;if(g.table=a,g.thead=!1,g.options=b,a.rows&&a.rows.length>0)if(a.tHead&&a.tHead.rows.length>0){for(e=0;e<a.tHead.rows.length;e++)if("thead"===a.tHead.rows[e].getAttribute("data-sort-method")){c=a.tHead.rows[e];break}c||(c=a.tHead.rows[a.tHead.rows.length-1]),g.thead=!0}else c=a.rows[0];if(c){var h=function(){g.current&&g.current!==this&&g.current.removeAttribute("aria-sort"),g.current=this,g.sortTable(this)};for(e=0;e<c.cells.length;e++)f=c.cells[e],f.setAttribute("role","columnheader"),"none"!==f.getAttribute("data-sort-method")&&(f.tabindex=0,f.addEventListener("click",h,!1),null!==f.getAttribute("data-sort-default")&&(d=f));d&&(g.current=d,g.sortTable(d))}},sortTable:function(a,g){var h=this,i=a.cellIndex,j=e,k="",l=[],m=h.thead?0:1,n=a.getAttribute("data-sort-method"),o=a.getAttribute("aria-sort");if(h.table.dispatchEvent(c("beforeSort")),g||(o="ascending"===o?"descending":"descending"===o?"ascending":h.options.descending?"descending":"ascending",a.setAttribute("aria-sort",o)),!(h.table.rows.length<2)){if(!n){for(;l.length<3&&m<h.table.tBodies[0].rows.length;)k=d(h.table.tBodies[0].rows[m].cells[i]),k=k.trim(),k.length>0&&l.push(k),m++