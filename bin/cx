d,123.4
d,234.5
b,456.7

 $ cat SOME.csv | cx cut -f %a%,%c% | cx sort --K %a%
a,c
b,456.7
d,123.4
d,234.5
g,345.6

 $ cat SOME.csv | cx sort -n --K %c%
a,b,c
d,e,123.4
d,f,234.5
g,h,345.6
b,i,456.7

 $ cat SOME.csv | cx datamash group %a% sum %c% | cx sort -rn --K %c_sum%
a,c_sum
b,456.7
d,357.9
g,345.6

