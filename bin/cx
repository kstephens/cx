  def tabular_rows args, table = self.table
    if cols = args.first && Csvx.csv_parse_line(args.first).map{|c| c.gsub(/^%|%$/, '')}
      table.cut(cols)
    else
      table
    end
  end

  #############################################################
  
  def method_command!
    method_command &&
    send(*method_command)
  end
  
  def script!
    @command = command.map{|arg| table.desc.replace_col_names(arg).first}
    @header = CSV.generate_line(columns).chomp
    output = Shellwords.join(@command)
    if @out_file
      output << " > #{@out_file.inspect}"
    end

    msg "> #{command * ' '} : header #{@header.inspect}"

    # Copy rest of @in to tmp file..path
    tmp = copy_to_tempfile!(inp).inspect
    rm_tmp = "rm -f #{tmp}"
    
    @script  = %Q{echo #{header.inspect} ; }    
    @script << %Q{trap '#{rm_tmp}' EXIT ; cat #{tmp} | #{output} ; #{rm_tmp} }
    log(:script!, args: args, columns: columns, header: header, command: command, output: output, script: script)
    self
  end

  def copy_to_tempfile! inp
    tmp = Tempfile.create("#{progname}.#{prog}.csv.").path
    File.open(tmp, "w") do | out |
      buf = ''.dup
      until inp.eof?
        inp.read(4096 * 16, buf)
        out.write(buf)
      end
    end
    tmp
  end
  
  def exec!
    # script = "set -x; #{self.script}"
    shell = ENV['SHELL'] || '/bin/sh'
    cmd_line = [shell, '-c', script]
    log(:exec!, script: script, cmd_line: cmd_line)
    Kernel.exec(*cmd_line)
    #Kernel.exec(script)
    # Kernel.spawn(*cmd_line)
    raise "exec failed"
  end

  def run!
    log(:run!, args: @args)
    opts!
    @command = @args.dup
    table!
    command!
    case
    when @method_command
      method_command!
    else
      script!
      exec!
    end
    self
  rescue
    _log(:ERROR,
        ERROR: $!,
         args: @args,
         command: @command,
         backtrace: $!.backtrace.reverse)
  end

  def msg *args
    $stderr.puts " ## cx : #{args * ' '}" if @verbose
    self
  end
  
  def log scope, msg, force = false
    _log scope, msg if force || @debug
  end
  
  def _log scope, msg
    @log.puts caller[0] if @debug
    msg = " #! cx : #{scope} : #{PP.pp(msg, '')}"
    msg.sub!(/\n\z/, '')
    msg.gsub!("\n", "\n# cx :")
    @log.puts msg
    self
  end

  def help!
    examples = DATA.read
    puts <<END
cx - process columnar data in a pipelie

Transforms and process data as CSV, JSON, EDN, etc.

Examples:

#{examples}
END
  end
  
  ############################################

  class LazyCSV
    include Enumerable
    include PPClean
    def initialize io
      @io = String === io ? File.open(io) : io
    end
    
    def each &blk
      @rows ||= Csvx.csv_parse(@io)
      @rows.each(&blk)
      self
    end

    def size
      @rows ? @rows.size : 0
    end
  end

  module Row
    attr_accessor :desc, :row_i
    
    def self.[] r, desc, row_i = nil
      r.extend(Row)
      r.desc = desc or raise
      r.row_i = row_i || 0
      r
    end

    def skip!
      @skip = true
      self
    end
    def skip? ; @skip ; end
    
    def at cols
      cols = cols.map{|c| @desc.c_to_i(c) or raise "unknown column #{c.inspect}"}
      r = values_at(*cols)
    end
  end
  
  class Table
    include Enumerable
    include PPClean

    attr_accessor :name, :desc

    def inspect
      "#<#{self.class.name} #{object_id} desc=#{@has_desc ? @desc.inspect : '???'} #{@rows.size} #{@name}>"
    end
    
    def initialize rows, desc = nil, name = nil
      @rows = rows
      @has_desc = ! ! desc
      @skip_first_row = false
      @desc = desc || Desc.new([])
      @name = name || "--UNKNOWN--"
      @desc.table = self
    end

    def << row
      @rows << Row[row.dup, @desc, @rows.size]
      self
    end
    
    def each
      raise unless block_given?
      row_i = -1
      @rows.each_with_index do | r, i |
        if i.zero?
          next if @skip_first_row || @has_desc
          @has_desc = @skip_first_row = true
          @desc.cols = r
          # pp(desc_from_row: @desc)
        else
          Row[r, @desc, row_i += 1]
          yield r unless r.skip?
        end
      end
      self
    end

    def desc
      each{|r| break} unless @has_desc
      @desc
    end
    
    def [] i
      desc
      _rows[@skip_first_row ? i + 1 : i]
    end
    
    def size
      desc
      @skip_first_row ? @rows.size - 1 : @rows.size
    end

    def col_type col
      @desc.col_type col
    end

    def col_types
      @desc.col_type(self)
    end
    
    def cut cols
      desc = Desc.new(cols)
      self_desc = self.desc
      inds = desc.cols.map{|c| self_desc.c_to_i(c)}
      Table.new(
        MappedEnum.new(self) do | r |
          r.values_at(*inds)
        end,
        desc)
    end

    def self.join j
      mktab = lambda do | lr |
        t = { table: j[:"#{lr}_table"] }
        cols = j[:"#{lr}_cols"]
        t[:desc]  = desc = ['*', '@', ''].include?(cols) ? t[:table].desc : Desc.new(cols)
        t[:cols]  = cols = desc.cols
        t[:join]  = Desc.new(j[:"#{lr}_join"]).cols
        t[:empty] = Row[[ nil ] * cols.size, desc]
        t
      end
      l = mktab[:l]
      r = mktab[:r]

      j_cols  = l[:cols].map{|c| j[:l_alias] + c} + r[:cols].map{|c| j[:r_alias] + c}
      j_desc  = Desc.new(j_cols)
      j_cols  = j_desc.cols
      j_name = l[:table].name + ' join ' + r[:table].name
      j_table = Table.new([], j_desc, j_name)

      # pp(l: l, r: r, j_cols: j_cols)
      
      # pp(l_cols: l_cols, r_cols: r_cols)

      j_index = Hash.new{|h, k| h[k] = [ [] , [] ]}
      [[l, 0], [r, 1]].each do | (t, i) |
        j_cols, t_cols = t[:join], t[:cols]
        t[:table].each do | r |
          j_index[r.at(j_cols)][i] << r.at(t_cols)
        end
      end

      # pp(j_index: j_index); exit
      # pp(j_index: j_index.map{|k,v| [k, v.map(&:size)]})
      
      l_empty, r_empty = l[:empty], r[:empty]
      join_rows = lambda do | blk |
        j_index.each do | j_k, (l_rows, r_rows) |
          begin
            l_rows, r_rows = blk.call(l_rows, r_rows)
            l_rows.each do | l_row |
              r_rows.each do | r_row |
                j_row = (l_row || l_empty) + (r_row || r_empty)
                j_table << j_row
              end
            end
          rescue => exc
            raise exc.class, "#{exc.inspect} : in join #{pps(j_k: j_k, l_rows: l_rows.size, r_rows: r_rows.size)}", exc.backtrace
          end
        end
      end

      l_empty_r, r_empty_r = [ l_empty ], [ r_empty ]
      case op = j[:op]
      when nil, 'inner', "="
        join_rows.call(lambda { | l_rows, r_rows |
                         [ l_rows,
                           r_rows ]
                       })
      when 'left-outer', 'lo', '/='
        join_rows.call(lambda { | l_rows, r_rows |
                         [ l_rows,
                           r_rows.empty? ? r_empty_r : r_rows ]
                       })
      when 'right-outer', 'ro', '=/'
        join_rows.call(lambda {| l_rows, r_rows |
                         [ l_rows.empty? ? l_empty_r : l_rows,
                           r_rows ]
                       })
      when 'outer', 'full-outer', 'fo', 'o', '/=/'
        join_rows.call(lambda { | l_rows, r_rows |
                         [ l_rows.empty? ? l_empty_r : l_rows,
                           r_rows.empty? ? r_empty_r : r_rows ]
                       })
      else
        raise ArgumentError, "invalid join op #{op}"
      end

      # j_table.write_csv!($stderr)
      j_table
    end
    
    def write_csv! out
      opts = { quote_empty: false }
      begin
        out << CSV.generate_line(desc.cols, opts)
        each do | r |
          out << CSV.generate_line(r, opts)
        end
      rescue Errno::EPIPE
      end
      out
    end

    class Desc
      def inspect
        "#<#{self.class.name} #{object_id} #{col_to_ind}>"
      end
      
      def initialize cols, table = nil
        @col_to_ind = @ind_to_col = @col_types = nil
        self.cols = cols
        @table = table
      end
      attr_accessor :table
      attr_reader :cols, :col_to_ind, :ind_to_col

      def << c
        self.cols = [ *self.cols, c ]
        self
      end

      def cols= cols
        cols = Csvx.csv_parse_line(cols.strip) if String === cols
        @col_types = nil
        @ind_to_col = { }
        @col_to_ind = { }
        i = -1
        @cols = cols.map do | c |
          i += 1
          c = clean_col_name(c).freeze
          @col_to_ind[c] ||= i
          @ind_to_col[i] ||= c
        end
        @cols.freeze
        @col_to_ind.freeze
        @ind_to_col.freeze
        self
      end

      def clean_col_name c
        c && c.gsub(/^%|%$/, '').gsub(/[()]/, '').gsub(/[^-_\w]/, '_')
      end
      
      def header
        @cols.join(',')
      end

      def c_to_i x
        Numeric === x ? x : @col_to_ind[x]
      end

      def c_to_c x
        Numeric === x ? @ind_to_col[x] : x
      end

      def col_type c
        col_types(@table)[c_to_i(c)] ||= ::String
      end
    
      def col_types table
        unless @col_types
          col_type_counts = Hash.new{|h1,k1| h1[k1] = Hash.new{|h2,k2| h2[k2] = 0} }
          table.each do | r |
            r.each_with_index do | v, i |
              col_type_counts[i][_col_type(v)] += 1
            end
          end
          @col_types = { }
          col_type_counts.each do | i, counts |
            counts.delete(::NilClass)
            @col_types[i] = (counts.to_a.sort_by{|x| - x[1]}.first.first rescue nil) || ::String
          end
        end
        @col_types
      end
    
      def _col_type v
        type = v.class
        case v
        when String
          case v.strip
          when ''
          when /^[-+]?(\d+|((\d+\.\d*|\.\d+)([eE][-+]?\d+)?))+$/
            type = ::Numeric
          end
        end
        type
      end

      # Assumes most progs want 1-origin.
      def replace_col_names arg, f = nil
        indexes = []
        names = []
        result = arg.gsub(/(%([^%]+)%)/) do | m |
          keyword = clean_col_name($1)
          name = clean_col_name($2)
          ind = c_to_i(name)
          col = ind ? ind + 1 : -1
          names   << name
          indexes << col
          # log(col: col)
          f ? f.call(name, col) : col
        end
        # $stderr.puts "  rcn #{arg.inspect} => #{result.inspect}"
        [result, indexes, names]
      end
    end

    class MappedEnum
      include Enumerable
      def initialize enum, &blk
        @enum, @fn = enum, blk
      end
      def each
        @enum.each do | e |
          yield @fn.call(e)
        end
      end
      def [] i
        @fn.call(@enum[i])
      end
      def size ; @enum.size; end
    end
    
  end
  
  class Test
  def run!
    test_dir = "tmp/cx.test"
    FileUtils.mkdir_p test_dir or raise
    Dir.chdir test_dir or raise

    help_file ="cx.examples"
    help_out = File.open(help_file, "w")
    
    data = DATA.read
    groups = data.gsub(/\n(\s+[\$\#])/){|m| "\1" + $1}.split("\1", -1).map{ |g| g.split("\n", -1).each{ |l| l << "\n" }}
    groups[-1].pop
    groups[-1].pop
    
    errors = []
    #pp(groups: groups)
    i = -1
    while group = @group = groups.shift
      group_ = group.map(&:dup)

      i += 1
      output_file = "test.#{i}.output"
      expect_file = "test.#{i}.expect"
      diff_file   = "test.#{i}.diff"
      input_file  = nil
      group << "\n"
      #puts group * ''
      #pp(group: group)

      while head = group.shift
        #pp(head: head)
        help_out << head
        case head
        when /^\s*$/, /^\s+\#/
        when %r{^\s+\$\s+(.* \| cx .*)$}
          cmd = $1.strip
          
          expect = take_until(nil)
          expect.pop
          expect = expect * ''
          File.write(expect_file, expect)

          system "#{cmd} > '#{output_file}' 2>&1"
          output = File.read(output_file)
          File.write(output_file, output)

          help_out << (help = String.new << output)
          # puts help

          diff_cmd = "diff -u '#{expect_file}' '#{output_file}' > '#{diff_file}' 2>&1" 
          system diff_cmd

          diff_result = File.read(diff_file)
          status = diff_result.empty? ? :OK : :FAILED
          #pp(diff_result: diff_result)
          puts <<"END"
#############
  cmd:    #{cmd}
  status: #{status}
  diff:   #{diff_cmd}
  expect:
  =========
#{File.read(expect_file)}  =========
  output: 
  =========
#{File.read(output_file)}  =========
  diff:
  =========
#{diff_result}=========
#############
END
          
          unless status == :OK
            pp(group: group_)
            errors << cmd
          end
        when %r{^\$\s+cat\s+\<\<END\s+\>\s*(\S+)$}
          input_file = $1.strip
          input = take_until("END\n") * ''
          #pp(input: input)
          File.write(input_file, input)

          help_out << (help = String.new << input << take!("END\n") << take!("\n"))
          # puts help
        else
          raise "unexpected line #{head.inspect}"
        end
      end
    end

    pp(errors: errors)
    errors.size
  rescue => exc
    pp(exc: exc, bt: exc.backtrace)
    raise
  ensure
    help_out.close
  end

  def take_until p, lines = @group
    p = pred(p)
    result = []
    while line = lines.first and ! p.call(line)
      line = lines.shift
      result << line
    end
    result
  end
  def take! p, lines = @group
    line = lines.shift
    pred(p).call(line) or raise "line #{line.inspect} does not match #{p.inspect}"
    line
  end
  def pred p
    case p
    when Proc
      p
    when Symbol
      lambda{ |x| x.send(p) } 
    when Regexp
      lambda{|x| p.match(x)}
    else
      lambda{ |x| p == x }
    end
  end
end

end

Csvx.new(ARGV).run!

# Help and test cases
