#!/usr/bin/env bash
dir='ex/cmd/eval/c396b1536ea537981e11f617422a073c'
cp -p ex/data/*.* "$dir"
PATH="$(/bin/pwd)/bin:$PATH"
cd "$dir" || exit 9
set -x
(
  bin/cx in a/SOME.csv // -h // parse // eval "row.map_vals!(&:class)" // h-
) >actual
echo $! > exit
[[ -f expected ]] || cp actual expected
diff -u expected actual | tee diff
[[ ! -s diff ]]
