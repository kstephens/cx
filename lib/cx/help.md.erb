# Commands

<% commands.each do | c | %>
## `<%= c.name %>`

<%= c.synopsis %>

<% unless c.aliases.empty? %>
Aliases: <%= c.aliases.map{|x| code x}.join(', ') %>
<% end %>

Invocation:

<span style='border-style: solid; padding: 0.5em;'>
`<%= c.name %>` \
<% if c.has_column_args? %>
*column-args* *...* \
<% end %> \
<% unless c.options.empty? %>
*[* \
<% c.options.each do |o| %>
<%= o.brief %> \
<% end %> \
*]* \
<% c.arguments.each do |n| %>
`<%= n %>` \
<% end %> \
<% if c.has_pipeline_args? %> \
*[* `{{` *pipeline* `}}` *...* \
<% end %>
</span>

<% unless c.options.empty? %>
  Options                   |  Description
----------------------------|------------------------------- \
<% c.options.each do | o | %>
<span style='white-space: nowrap;'><%= code(o.brief) %></span> | <%= o.description %> \
<% end %>
<% end %>

<%= c.description unless c.description.empty? %>

<% unless c.examples.empty? %>
  Examples:

<% c.examples.each do | e |
   e = Example.load!(command: c.name, example: e) %>
```
$ <%= e.example %>
<%= e.contents.actual %>
```
<% end %>
<% end %>
<% end %>
<% end %>

